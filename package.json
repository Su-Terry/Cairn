{
  "name": "cairn",
  "displayName": "Cairn",
  "description": "Mark every experiment with a stable waypoint",
  "version": "0.0.1",
  "publisher": "su-terry",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Su-Terry/Cairn.git"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cairn.helloWorld",
        "title": "Hello World",
        "category": "Cairn"
      },
      {
        "command": "cairn.refreshExperiments",
        "title": "Refresh",
        "category": "Cairn",
        "icon": "$(refresh)"
      },
      {
        "command": "cairn.createBrief",
        "title": "New Experiment Brief",
        "category": "Cairn",
        "icon": "$(add)"
      },
      {
        "command": "cairn.copyAgentPrompt",
        "title": "Copy Agent Prompt",
        "category": "Cairn",
        "icon": "$(clippy)"
      },
      {
        "command": "cairn.changeStatus",
        "title": "Change Status",
        "category": "Cairn",
        "icon": "$(edit)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cairn",
          "title": "Cairn",
          "icon": "$(milestone)"
        }
      ]
    },
    "views": {
      "cairn": [
        {
          "id": "cairn.experiments",
          "name": "Experiments"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "cairn.createBrief",
          "when": "view == cairn.experiments",
          "group": "navigation@1"
        },
        {
          "command": "cairn.refreshExperiments",
          "when": "view == cairn.experiments",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "cairn.copyAgentPrompt",
          "when": "view == cairn.experiments && viewItem =~ /^cairnExperiment\\./",
          "group": "inline"
        },
        {
          "command": "cairn.copyAgentPrompt",
          "when": "view == cairn.experiments && viewItem =~ /^cairnExperiment\\./",
          "group": "navigation"
        },
        {
          "command": "cairn.changeStatus",
          "when": "view == cairn.experiments && viewItem =~ /^cairnExperiment\\./",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.95.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "esbuild": "^0.27.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}